{
  "specification": "social-recipe-anylist deterministic unit conversion",
  "version": "unit-conversion-v1",
  "milestone": "M5G-B4-C",
  "description": "Golden vectors for the Original / US / Metric projection engine. The Swift implementation in B4-D must copy this file verbatim, pin its SHA-256, and produce identical results for every vector.",
  "assumptions": [
    "A bare 'oz' is mass. Fluid ounces must say so ('fl oz', 'fluid ounce').",
    "'cup' is the US customary cup, 236.5882365 ml — not the metric 250 ml, the US labelling 240 ml, or the imperial 284 ml.",
    "'tsp' and 'tbsp' are US customary. The 20 ml Australian tablespoon is not supported.",
    "'pint', 'quart' and 'gallon' are US liquid measures, not imperial.",
    "Unit matching is exact against the alias table below. There is no fuzzy matching, and an unmatched unit is never converted.",
    "Mass and volume are never converted into one another. No density table exists in this engine.",
    "A calculated conversion is never written back into alternateMeasurements.",
    "Output fractions are ASCII ('1/2'), never Unicode ('½')."
  ],
  "constants": {
    "gramsPerOunce": 28.349523125,
    "gramsPerPound": 453.59237,
    "gramsPerKilogram": 1000,
    "millilitresPerLitre": 1000,
    "millilitresPerFluidOunce": 29.5735295625,
    "millilitresPerTeaspoon": 4.92892159375,
    "millilitresPerTablespoon": 14.78676478125,
    "millilitresPerCup": 236.5882365,
    "millilitresPerPint": 473.176473,
    "millilitresPerQuart": 946.352946,
    "millilitresPerGallon": 3785.411784
  },
  "rounding": {
    "snapTolerance": 0.05,
    "ladder": [
      "0",
      "1/8",
      "1/4",
      "1/3",
      "1/2",
      "2/3",
      "3/4",
      "1"
    ],
    "usVolumeLadder": [
      {
        "unit": "cup",
        "floor": 0.25
      },
      {
        "unit": "tbsp",
        "floor": 1
      },
      {
        "unit": "tsp",
        "floor": 1
      }
    ],
    "perUnit": {
      "g": "one decimal below 10 g, whole grams at or above",
      "ml": "nearest half millilitre below 10 ml, whole millilitres at or above",
      "oz": "one decimal",
      "kg": "at most two decimals",
      "lb": "at most two decimals",
      "l": "at most two decimals"
    },
    "unitSelection": {
      "metricMass": "kg at or above 1000 g, else g",
      "usMass": "lb at or above 16 oz, else oz",
      "metricVolume": "l at or above 1000 ml, else ml",
      "usVolume": "largest ladder unit clearing its floor whose value snaps within tolerance; else largest unit holding one whole unit, snapped to the nearest eighth",
      "range": "both ends share the unit chosen by the LOWER end"
    }
  },
