# Copy to .env and fill in. .env is gitignored and must stay that way.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Anthropic API key used for recipe extraction.
ANTHROPIC_API_KEY=

# The AnyList account recipes are saved into.
ANYLIST_EMAIL=
ANYLIST_PASSWORD=

# Bearer token for the HTTP API.
# Generate one with: openssl rand -hex 32
# Must NOT be an Anthropic or AnyList credential.
RECIPE_API_KEY=

# ---------------------------------------------------------------------------
# Redis — durable idempotency for POST /api/exports/anylist
# ---------------------------------------------------------------------------
#
# Only ONE credential pair is needed. Both namings are read, per variable,
# with the KV_ names taking precedence when both are present:
#
#   KV_REST_API_URL      or  UPSTASH_REDIS_REST_URL
#   KV_REST_API_TOKEN    or  UPSTASH_REDIS_REST_TOKEN
#
# Two namings exist because the Vercel Marketplace Upstash integration has
# injected each of them. On Vercel the integration sets whichever pair it
# uses and you do not fill these in by hand.
#
# Locally these may be left empty: the server falls back to an in-process
# store and warns. That fallback is refused when VERCEL is set, because an
# in-process store is lost on restart and invisible to other instances —
# a duplicate-prevention guarantee it cannot keep.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Equivalent alias pair. Set these instead of the two above, not as well.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---------------------------------------------------------------------------
# Local server binding only. Vercel supplies its own.
# ---------------------------------------------------------------------------

# HOST=127.0.0.1
# PORT=3000

# ---------------------------------------------------------------------------
# Unused
# ---------------------------------------------------------------------------
#
# Left over from the original scaffold and read by nothing in this codebase.
# Nothing depends on them and neither the CLI nor a deployment requires them.
# Listed only so their absence is not mistaken for an oversight.
#
# OPENAI_API_KEY
# APIFY_API_TOKEN
